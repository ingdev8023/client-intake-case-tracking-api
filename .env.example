# SQLite local development
DATABASE_URL=sqlite:///app.db

# PostgreSQL local development example
DATABASE_URL=postgresql://username:password@localhost:5432/client_intake_dev

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minimum 32 UTF-8 bytes for HS256.
# Changing this value invalidates previously issued JWTs.
JWT_SECRET_KEY=your-secret-key

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:xxxx,http://xxx.xxx.xxx.xxx:xxxx